{
  "name": "github-contribution-growth-graph",
  "version": "0.0.0",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"web/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.ts\" \"web/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"web/**/*.{ts,tsx}\" --fix",
    "generate:auth:openapi": "swagger2openapi ./node_modules/@qkitzero/auth-service-openapi/gen/openapiv2/auth/v1/auth.swagger.json -o ./src/infrastructure/api/auth/openapi.json",
    "generate:logging:openapi": "swagger2openapi ./node_modules/@qkitzero/logging-service-openapi/gen/openapi.json -o ./src/infrastructure/api/logging/openapi.json",
    "generate:auth:schema": "openapi-typescript ./src/infrastructure/api/auth/openapi.json -o ./src/infrastructure/api/auth/schema.ts",
    "generate:logging:schema": "openapi-typescript ./src/infrastructure/api/logging/openapi.json -o ./src/infrastructure/api/logging/schema.ts",
    "generate:all": "npm run generate:auth:openapi && npm run generate:auth:schema && npm run generate:logging:openapi && npm run generate:logging:schema",
    "build": "rimraf dist && tsc && npm run build:web",
    "build:web": "tsc -p web/tsconfig.json && vite build",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:web": "vite",
    "test": "jest",
    "test:cov": "jest --coverage",
    "coverage:open": "open coverage/lcov-report/index.html"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "express": "^5.2.0",
    "express-rate-limit": "^8.5.1",
    "graphql-request": "^7.3.5",
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@qkitzero/auth-service-openapi": "^1.5.0",
    "@qkitzero/logging-service-openapi": "^1.3.4",
    "@tsconfig/node24": "^24.0.3",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.4.0",
    "jest": "^30.2.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.7.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.2",
    "swagger2openapi": "^7.0.8",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.16"
  }
}
